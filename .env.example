NODE_ENV=development
PORT=6610

# MongoDB — use <password> placeholder if embedding credentials in URI
DATABASE=mongodb+srv://user:<password>@cluster.example.net/bod
DATABASE_PASSWORD=

JWT_SECRET=
JWT_EXPIRES_IN=15m
# Omit or leave unset to reuse JWT_SECRET. Do not set to blank (`JWT_REFRESH_SECRET=`) — that breaks refresh/login.
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN=7d
PUBLIC_LINK_SECRET=
PUBLIC_LINK_EXPIRES_IN=14d

API_URL=http://localhost:6610
FRONTEND_URL=http://localhost:3000

EMAIL_HOST=
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_REQUIRE_TLS=true
EMAIL_TLS_REJECT_UNAUTHORIZED=true
EMAIL_ADDRESS=
EMAIL_FROM=
EMAIL_PASSWORD=
EMAIL_TO=

COMPANY_NAME=BOD

# Backblaze B2 (required for uploads in production)
B2_APPLICATION_KEY_ID=
B2_APPLICATION_KEY=
B2_BUCKET_ID=
B2_BUCKET_NAME=
B2_PUBLIC_BASE_URL=

# Paystack
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
PAYSTACK_WEBHOOK_SECRET=

# Optional seed (npm run seed) — only when DB is empty
SEED_OWNER_EMAIL=support@jahbyte.com
SEED_OWNER_PASSWORD=ChangeMe123!
SEED_COMPANY_NAME=BOD

ENCRYPTION_KEY=wgrrte