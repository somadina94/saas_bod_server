doctype html
html
  head
    meta(charset="utf-8")
    meta(name="viewport" content="width=device-width, initial-scale=1")
    title= subject || companyName
  body(style="font-family: system-ui, -apple-system, Segoe UI, Roboto, sans-serif; line-height: 1.5; color: #1a1a1a; max-width: 560px; margin: 0 auto; padding: 24px;")
    if companyName
      p(style="font-weight: 600; font-size: 18px; margin: 0 0 16px;")= companyName
    block content
    hr(style="border: none; border-top: 1px solid #e5e5e5; margin: 24px 0;")
    p(style="font-size: 12px; color: #737373; margin: 0;") This message was sent by #{companyName || 'your organization'}.
