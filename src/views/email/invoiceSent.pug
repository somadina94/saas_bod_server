extends _layout

block content
  p Hello #{customerName},
  p Thank you for your business. #[strong= companyName] has issued invoice #[strong= invoiceNumber] for #[strong= formattedTotal] (#{currency}).
  p Amount due by #[strong= dueDateLabel].
  if notes
    p(style="background:#fafaf8;padding:14px;border-left:3px solid #1c1917;margin:18px 0;font-size:14px;color:#44403c;")
      span(style="font-size:11px;text-transform:uppercase;letter-spacing:0.08em;color:#78716c;display:block;margin-bottom:6px;") Note from #{companyName}
      | #{notes}
  p A PDF copy is attached for your records.
  if viewUrl
    p(style="margin-top:22px;")
      a(href=viewUrl style="display:inline-block;padding:12px 24px;background:#1c1917;color:#ffffff;text-decoration:none;font-weight:600;font-size:14px;font-family:system-ui,-apple-system,Segoe UI,sans-serif;") View invoice online
  if paymentUrl
    p(style="margin-top:12px;")
      a(href=paymentUrl style="display:inline-block;padding:12px 24px;background:#166534;color:#ffffff;text-decoration:none;font-weight:600;font-size:14px;font-family:system-ui,-apple-system,Segoe UI,sans-serif;") Pay securely now
  p(style="font-size:13px;color:#78716c;margin-top:22px;line-height:1.55;") Questions about this invoice? Reply to this email and our team will assist you promptly.
