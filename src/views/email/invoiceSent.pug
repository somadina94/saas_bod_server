extends _layout

block content
  p Hi #{customerName},
  p A new invoice #[strong= invoiceNumber] has been issued for #{currency} #{formattedTotal}.
  p Due date: #[strong= dueDateLabel].
  if notes
    p Notes: #{notes}
  if viewUrl
    p
      a(href=viewUrl style="display: inline-block; padding: 10px 18px; background: #171717; color: #fff; text-decoration: none; border-radius: 6px;") View invoice
  if paymentUrl
    p
      a(href=paymentUrl style="display: inline-block; padding: 10px 18px; background: #0a7a34; color: #fff; text-decoration: none; border-radius: 6px;") Pay now
  p(style="font-size: 13px; color: #737373;") If you have questions, reply to this email or contact us.
