extends _layout

block content
  p Hi #{firstName},
  if status === 'approved'
    p Your expense #[strong= title] (#{currency} #{formattedAmount}) has been #[strong(style="color:#166534;") approved]. It will flow through to your finance records as configured by #[strong= companyName].
  else
    p Your expense #[strong= title] (#{currency} #{formattedAmount}) could not be approved at this time.
    if reason
      p(style="background:#fff7ed;padding:14px;border-left:3px solid #c2410c;margin:16px 0;font-size:14px;color:#431407;")
        span(style="font-size:11px;text-transform:uppercase;letter-spacing:0.08em;color:#9a3412;display:block;margin-bottom:6px;") Reviewer note
        | #{reason}
  p(style="font-size:13px;color:#78716c;margin-top:18px;") Submitted: #{submittedAtLabel}
  p(style="font-size:13px;color:#78716c;margin-top:12px;line-height:1.55;") Questions? Reach out to your manager or finance lead in #[strong= companyName].
