extends _layout

block content
  p Hello #{customerName},
  p #[strong= companyName] has prepared quotation #[strong= quotationNumber] for your review—total #[strong= formattedTotal] (#{currency}).
  if validUntilLabel
    p This proposal remains valid until #[strong= validUntilLabel].
  p A PDF summary is attached. Review the line items and let us know when you are ready to proceed.
  if viewUrl
    p(style="margin-top:22px;")
      a(href=viewUrl style="display:inline-block;padding:12px 24px;background:#1c1917;color:#ffffff;text-decoration:none;font-weight:600;font-size:14px;font-family:system-ui,-apple-system,Segoe UI,sans-serif;") View quotation online
  p(style="font-size:13px;color:#78716c;margin-top:22px;line-height:1.55;") Ready to move forward? Reply to this email or reach out to your account contact—we are happy to refine the scope.
