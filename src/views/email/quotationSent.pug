extends _layout

block content
  p Hi #{customerName},
  p Quotation #[strong= quotationNumber] is ready for your review (total #{currency} #{formattedTotal}).
  if validUntil
    p Valid until: #[strong= validUntilLabel].
  if viewUrl
    p
      a(href=viewUrl style="display: inline-block; padding: 10px 18px; background: #171717; color: #fff; text-decoration: none; border-radius: 6px;") View quotation
  p(style="font-size: 13px; color: #737373;") If you have questions, reply to this email or contact us.
