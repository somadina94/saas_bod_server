extends _layout

block content
  p Hi #{firstName},
  p We received a request to reset the password for your #[strong= companyName] account.
  p For your security, this link expires in one hour. Click the button below to choose a new password:
  p(style="margin-top:22px;")
    a(href=resetUrl style="display:inline-block;padding:12px 24px;background:#1c1917;color:#ffffff;text-decoration:none;font-weight:600;font-size:14px;font-family:system-ui,-apple-system,Segoe UI,sans-serif;") Reset my password
  p(style="font-size:13px;color:#78716c;margin-top:20px;line-height:1.55;") If you did not request this email, you can safely ignore it—your password will not change.
  p(style="word-break:break-all;font-size:11px;color:#a8a29e;margin-top:16px;font-family:ui-monospace,monospace;")= resetUrl
